# 角色 → 供應商：openai | anthropic | qwen | mock（未設定的角色用 GRADER_PROVIDER）
GRADER_PROVIDER=mock
GRADER_PROVIDER_VISION=anthropic     # 畫面描述（需要視覺）
GRADER_PROVIDER_AUTHOR=anthropic     # 還原問題、出遷移題
GRADER_PROVIDER_STUDENT=qwen         # AI 小明（<=30B）
GRADER_PROVIDER_JUDGE=openai         # 判分、正確性審查

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Qwen：用 vLLM 的 OpenAI 相容端點（見 scripts/serve_qwen.sh）
QWEN_BASE_URL=http://localhost:8000/v1
QWEN_MODEL=Qwen/Qwen3-30B-A3B

# ASR（faster-whisper）
GRADER_WHISPER_MODEL=large-v3
